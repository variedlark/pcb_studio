{
  "name": "local-engineering-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Local-only engineering desktop application monorepo",
  "scripts": {
    "dev": "pnpm --filter desktop-ui dev",
    "build": "pnpm --filter desktop-ui build",
    "test": "pnpm --filter desktop-ui test",
    "check": "pnpm -r run check",
    "lint": "pnpm -r run lint",
    "check:generated": "python3 scripts/check_generated_bloat.py",
    "check:boundaries": "python3 scripts/check_architecture_boundaries.py",
    "check:duplicates": "python3 scripts/check_structural_duplicates.py",
    "check:file-size": "python3 scripts/check_file_size_limits.py",
    "check:critical": "python3 scripts/check_no_critical_unwrap.py",
    "fmt": "cargo fmt --all && pnpm --filter desktop-ui format",
    "rust:check": "cargo check",
    "rust:test": "cargo test"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
      "vite@>=7.1.0 <=7.3.1": ">=7.3.2",
      "postcss@<8.5.10": ">=8.5.10",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "postcss@<=8.5.11": ">=8.5.12",
      "seroval@<=1.5.2": ">=1.5.3",
      "postcss@<=8.5.22": ">=8.5.23",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "nanoid@<3.3.16": ">=3.3.16",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.17": ">=8.5.18",
      "vitest@<3.2.6": ">=3.2.6",
      "browserslist@<=4.28.6": ">=4.28.7",
      "nanoid@<3.3.12": ">=3.3.12",
      "@humanfs/node@<0.16.8": ">=0.16.8",
      "@xmldom/xmldom@>=0.7.0 <=0.8.14": ">=0.8.15",
      "fflate@>=0.8.0 <0.8.3": ">=0.8.3",
      "fflate": ">=0.8.3",
      "three-stdlib>fflate": ">=0.8.3",
      "fflate@>=0.6.0 <0.6.11": ">=0.6.11",
      "vitest@>=2.1.0 <4.1.11": ">=4.1.11",
      "@vitest/mocker@>=2.1.0 <4.1.11": ">=4.1.11",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": ">=2.11.0",
      "@xmldom/xmldom@>=0.7.0 <=0.8.13": ">=0.8.14",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "seroval@>=0.12.0 <=1.6.0": ">=1.6.2",
      "seroval@<=1.6.2": ">=1.6.3",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "tinypool@<=2.1.0": ">=2.1.1",
      "tinypool@<2.1.2": ">=2.1.2",
